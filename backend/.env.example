# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/visitor_pass_db?schema=public

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# ── Frontend URL (used for CORS) ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── File Storage ──────────────────────────────────────────────────────────────
# 'local'  → uploads stored in backend/uploads/ (dev default)
# 's3'     → uploads stored in AWS S3 (production)
STORAGE_PROVIDER=local

# ── AWS (required when STORAGE_PROVIDER=s3 or EMAIL_PROVIDER=ses) ─────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-visitor-pass-bucket
# Leave blank on EC2 to use the attached IAM Instance Profile automatically.
# Only set these for local development with a dedicated IAM user.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# 'smtp' → Nodemailer SMTP (default for local dev)
# 'ses'  → AWS Simple Email Service (production)
# 'mock' → logs emails to console only (CI / no-email testing)
EMAIL_PROVIDER=smtp
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── Twilio SMS (optional) ─────────────────────────────────────────────────────
# Leave blank to disable SMS notifications gracefully.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Auto-checkout job ─────────────────────────────────────────────────────────
# Visitors checked in longer than AUTO_CHECKOUT_AFTER_MIN are auto checked-out.
AUTO_CHECKOUT_AFTER_MIN=60
# How often the in-process job runs (minutes). Ignored when using Lambda.
AUTO_CHECKOUT_INTERVAL_MIN=5
